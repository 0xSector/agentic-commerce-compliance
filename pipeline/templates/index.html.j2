<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Agentic Payments Risk Analysis — {{ run_date }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root { color-scheme: light; }
body { background: #fff; color: #111; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 980px; margin: 40px auto; padding: 0 20px; line-height: 1.5; }
h1 { margin-bottom: 4px; }
.sub { color: #666; margin-bottom: 32px; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e3e3e3; vertical-align: top; }
th { background: #f7f7f7; font-weight: 600; }
.tier-LOW { color: #0a7d2b; font-weight: 600; }
.tier-MEDIUM { color: #b06a00; font-weight: 600; }
.tier-HIGH { color: #b00020; font-weight: 600; }
.addr { font-family: "SF Mono", Menlo, monospace; font-size: 12px; }
.pill { display: inline-block; padding: 2px 8px; border-radius: 999px; background: #eef; font-size: 11px; margin-right: 4px; }
footer { margin-top: 48px; color: #888; font-size: 12px; }
</style>
</head>
<body>

<h1>Agentic Payments Risk Analysis</h1>
<div class="sub">Weekly snapshot · window {{ window_start }} → {{ window_end }} · generated {{ run_date }}</div>

<section style="margin-bottom:28px">
  <p style="margin:0">This tool analyzes the risk of counterparties interacting with agentic payment protocols (x402 on Base, MPP on Tempo). Top buyers of people-search and identity APIs are ranked weekly and each is enriched with funding-source trace, sanctions screening, and a compliance risk tier. Click any wallet for the full report.</p>
</section>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Wallet</th>
      <th>Spend (USD)</th>
      <th>Tx</th>
      <th>Chains</th>
      <th>Origins / Servers</th>
      <th>Risk</th>
    </tr>
  </thead>
  <tbody>
  {% for row in buyers %}
    <tr>
      <td>{{ loop.index }}</td>
      <td class="addr"><a href="reports/{{ row.buyer.address }}.html">{{ row.buyer.address }}</a></td>
      <td>${{ "%.2f"|format(row.buyer.total_usd) }}</td>
      <td>{{ row.buyer.total_tx }}</td>
      <td>{% for c in row.buyer.chains %}<span class="pill">{{ c }}</span>{% endfor %}</td>
      <td>
        {% for o in row.buyer.origins %}<span class="pill">{{ o }}</span>{% endfor %}
        {% for s in row.buyer.mpp_servers %}<span class="pill">mpp:{{ s[:8] }}…</span>{% endfor %}
      </td>
      <td class="tier-{{ row.risk.tier }}">{{ row.risk.tier }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<footer>
Data: x402scan, mppscan/Allium, Nansen, TRM, Arkham.
</footer>
</body>
</html>
